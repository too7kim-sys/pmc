<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags" %>
<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>PMC 장애예방점검 자동화</title>
    <link rel="stylesheet" href="<c:url value='/css/pmc.css'/>">
</head>
<body>
<header class="top">
    <h1>🛡 장애예방점검 자동화 시스템 (PMC)</h1>
    <div class="user">
        <sec:authentication property="name"/> 님
        <a href="<c:url value='/logout'/>">로그아웃</a>
    </div>
</header>
<nav class="gnb">
    <%-- 데이터 구동형 GNB(2단계): 로그인 롤이 접근 허용된 메뉴(comtnauthormenu)만 노출.
         메뉴/권한관리 화면에서 제어. (URL 접근통제는 context-security.xml 이 1차 적용) --%>
    <c:forEach var="m" items="${gnbMenus}">
        <c:choose>
            <c:when test="${empty m.children}">
                <a href="<c:url value='${m.menuUrl}'/>"><c:out value="${m.menuNm}"/></a>
            </c:when>
            <c:otherwise>
                <span class="gnb-group">
                    <c:choose>
                        <c:when test="${not empty m.menuUrl}"><a href="<c:url value='${m.menuUrl}'/>"><c:out value="${m.menuNm}"/> ▾</a></c:when>
                        <c:otherwise><a href="#" onclick="return false;"><c:out value="${m.menuNm}"/> ▾</a></c:otherwise>
                    </c:choose>
                    <span class="gnb-sub">
                        <c:forEach var="ch" items="${m.children}">
                            <a href="<c:url value='${ch.menuUrl}'/>"><c:out value="${ch.menuNm}"/></a>
                        </c:forEach>
                    </span>
                </span>
            </c:otherwise>
        </c:choose>
    </c:forEach>
    <c:if test="${empty gnbMenus}">
        <a href="<c:url value='/pmc/dashboard.do'/>">대시보드</a>
    </c:if>
</nav>
<main>
