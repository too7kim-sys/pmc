<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="egovframework.let.pmc.report.service.ReportMapper">

    <insert id="insertReport" parameterType="egovframework.let.pmc.report.service.ReportVO"
            useGeneratedKeys="true" keyProperty="reportId" keyColumn="report_id">
        INSERT INTO pmc_report(report_type, scope_type, plan_id, server_id, run_id,
               period_from, period_to, file_path, file_name, file_size, gen_status, reg_user)
        VALUES(#{reportType}, #{scopeType}, #{planId}, #{serverId},
               <choose><when test="runId != null">CAST(#{runId} AS uuid)</when><otherwise>NULL</otherwise></choose>,
               #{periodFrom}, #{periodTo},
               #{filePath}, #{fileName}, #{fileSize}, COALESCE(#{genStatus},'DONE'), 'admin')
    </insert>

    <resultMap id="reportMap" type="egovframework.let.pmc.report.service.ReportVO">
        <result property="reportId" column="report_id"/>
        <result property="reportType" column="report_type"/>
        <result property="scopeType" column="scope_type"/>
        <result property="planId" column="plan_id"/>
        <result property="serverId" column="server_id"/>
        <result property="runId" column="run_id"/>
        <result property="periodFrom" column="period_from"/>
        <result property="periodTo" column="period_to"/>
        <result property="filePath" column="file_path"/>
        <result property="fileName" column="file_name"/>
        <result property="fileSize" column="file_size"/>
        <result property="genStatus" column="gen_status"/>
        <result property="regDt" column="reg_dt"/>
    </resultMap>

    <select id="selectReportList" resultMap="reportMap">
        SELECT * FROM pmc_report ORDER BY report_id DESC LIMIT 200
    </select>

    <select id="selectReport" resultMap="reportMap">
        SELECT * FROM pmc_report WHERE report_id=#{reportId}
    </select>

</mapper>
